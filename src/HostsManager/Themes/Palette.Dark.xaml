<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark palette. Role colours are pulled toward the light end of their ramp and their
        tinted backgrounds toward the dark end, so status badges keep their contrast
        instead of inverting into mud.
    -->

    <SolidColorBrush x:Key="Surface0" Color="#1B1B19" />
    <SolidColorBrush x:Key="Surface1" Color="#232322" />
    <SolidColorBrush x:Key="Surface2" Color="#2A2A28" />
    <SolidColorBrush x:Key="Border0" Color="#3A3A37" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4E4E4A" />

    <SolidColorBrush x:Key="TextPrimary" Color="#EDEDEA" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B4B2A9" />
    <SolidColorBrush x:Key="TextMuted" Color="#8B8A83" />

    <SolidColorBrush x:Key="Accent" Color="#85B7EB" />
    <SolidColorBrush x:Key="AccentBg" Color="#12324F" />
    <SolidColorBrush x:Key="AccentBorder" Color="#2A5F92" />

    <SolidColorBrush x:Key="Success" Color="#5DCAA5" />
    <SolidColorBrush x:Key="SuccessBg" Color="#0F3A30" />
    <SolidColorBrush x:Key="SuccessFill" Color="#1D9E75" />

    <SolidColorBrush x:Key="Danger" Color="#F09595" />
    <SolidColorBrush x:Key="DangerBg" Color="#4A1B1B" />

    <SolidColorBrush x:Key="Warning" Color="#EF9F27" />
    <SolidColorBrush x:Key="WarningBg" Color="#3E2708" />
    <SolidColorBrush x:Key="WarningBorder" Color="#6B4210" />

    <SolidColorBrush x:Key="ToggleTrackOff" Color="#4E4E4A" />
    <SolidColorBrush x:Key="ToggleThumb" Color="#EDEDEA" />

</ResourceDictionary>
