<Window x:Class="HostsManager.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Hosts manager" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Background="{DynamicResource Surface0}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,26,24,0">
            <Image Source="../Assets/app.ico" Width="56" Height="56" HorizontalAlignment="Center" />

            <TextBlock Text="Hosts manager" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,2"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Add, remove and toggle Windows hosts file entries without hand-editing a system file."
                       FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="16,16,16,0" />

            <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Installed at" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock x:Name="InstallPathText" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,10" Margin="0,18,0,0">
            <Grid>
                <Button Content="Open backups folder" Style="{StaticResource ToolButton}" Padding="12,7"
                        HorizontalAlignment="Left" Click="OnOpenBackups" />
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Padding="18,7"
                        HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
