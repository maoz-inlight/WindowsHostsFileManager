<Window x:Class="HostsManager.Views.GroupNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group name" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Background="{DynamicResource Surface0}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="Name" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5" />
        <TextBox x:Name="NameBox" Style="{StaticResource FlatTextBox}" TextChanged="OnChanged" />

        <Border x:Name="ErrorBox" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="10,8"
                Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource ToolButton}" Padding="16,7" IsCancel="True" />
            <Button x:Name="AcceptButton" Content="Save" Style="{StaticResource PrimaryButton}"
                    Padding="20,7" Margin="6,0,0,0" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
