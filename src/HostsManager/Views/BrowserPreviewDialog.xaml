<Window x:Class="HostsManager.Views.BrowserPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open with overrides" Height="780" Width="700" MinHeight="520" MinWidth="520"
        Background="{DynamicResource Surface0}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="HeadingText" Text="Open in an isolated browser"
                           FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Margin="0,6,0,16" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="These mappings apply only to the new browser window. The Windows hosts file and your normal browser are not changed." />

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Browser" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="BrowserBox" Style="{StaticResource FlatComboBox}"
                              ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                              DisplayMemberPath="DisplayName" SelectionChanged="OnInputChanged" />
                </Grid>

                <Border Grid.Row="3" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                        BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tabs to open" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                            <ItemsControl x:Name="StartPagesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="OnStartPageChanged" Unchecked="OnStartPageChanged" />
                                            <TextBox Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                                     Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="OnStartPageChanged" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                        BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Session mappings" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="70">
                            <TextBlock x:Name="MappingsText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" Margin="0,12,0,0">
                    <TextBlock Text="Preview cookies and other browser data are retained and reused." TextWrapping="Wrap"/>
                    <Button Content="Manage retained preview data…" Click="OnManageProfiles"
                            HorizontalAlignment="Left" Margin="0,6,0,12" Style="{StaticResource ToolButton}"/>
                    <TextBlock Text="Browser options" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl x:Name="FlagOptionsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="OnStartPageChanged" Unchecked="OnStartPageChanged"
                                          Foreground="{DynamicResource TextPrimary}" Margin="0,4,12,4"
                                          ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="The first three options reduce browser security. Use them only for sites you trust while testing."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,12" />
                    <Label Target="{Binding ElementName=FlagsBox}" Content="Additional flags (optional)"
                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Padding="0" />
                    <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="One flag per line: --name or --name=value. Values can contain spaces; no surrounding quotes are needed. Example: --disable-extensions" />
                    <TextBox x:Name="FlagsBox" Style="{StaticResource FlatTextBox}" Height="84"
                             FontFamily="{StaticResource MonoFont}" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextChanged="OnStartPageChanged"
                             AutomationProperties.Name="Additional browser flags" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Cancel" Style="{StaticResource ToolButton}" Padding="16,7" IsCancel="True" />
                <Button x:Name="OpenButton" Content="Open isolated" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" Margin="6,0,0,0" IsDefault="True" Click="OnOpen" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
