<Window x:Class="HostsManager.Views.ProfileAppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HostsManager.Views"
        Title="Preview profile name and color" Width="540" Height="410" MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface0}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ProfileLabel" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <views:PreviewAppearancePicker x:Name="Picker"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolButton}"/>
            <Button Content="Save" Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
