<Window x:Class="HostsManager.Views.BackupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backups" Width="720" Height="520" WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Background="{DynamicResource Surface0}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <TextBlock Text="A backup is taken before every save. Restoring also backs up the current state first, so a restore can itself be undone."
                       FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        </Border>

        <DataGrid Grid.Row="1" x:Name="BackupGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border0}"
                  Background="{DynamicResource Surface2}" BorderThickness="0" RowHeight="32"
                  ColumnHeaderStyle="{StaticResource GridColumnHeader}" CellStyle="{StaticResource GridCell}"
                  RowStyle="{StaticResource GridRow}"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="70"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Intact" Binding="{Binding Intact}" Width="70"
                                    ElementStyle="{StaticResource GridCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel>
                <TextBlock Text="If this app will not start, restore by hand from an elevated Command Prompt:"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" />
                <TextBox x:Name="ManualCommand" Style="{StaticResource FlatTextBox}"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" IsReadOnly="True" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Button Content="Open folder" Style="{StaticResource ToolButton}" Padding="14,7"
                        HorizontalAlignment="Left" Click="OnOpenFolder" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource ToolButton}" Padding="16,7" IsCancel="True" />
                    <Button x:Name="RestoreButton" Content="Restore selected" Style="{StaticResource PrimaryButton}"
                            Padding="18,7" Margin="6,0,0,0" Click="OnRestore" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
