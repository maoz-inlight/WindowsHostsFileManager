<Window x:Class="HostsManager.Views.GroupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Groups" Width="660" Height="480" MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner" Icon="../Assets/app.ico"
        Background="{DynamicResource Surface0}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <StackPanel>
                <TextBlock Text="Filter related entries and enable or disable them together. Changes remain pending until Save."
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                <TextBlock x:Name="SelectionText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="GroupsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border0}"
                  Background="{DynamicResource Surface2}" BorderThickness="0" RowHeight="34"
                  ColumnHeaderStyle="{StaticResource GridColumnHeader}" CellStyle="{StaticResource GridCell}"
                  RowStyle="{StaticResource GridRow}" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Entries" Binding="{Binding CountText}" Width="110"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"
                                    ElementStyle="{StaticResource GridCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NewButton" Content="New from selection…" Style="{StaticResource ToolButton}"
                            Click="OnNew" />
                    <Button x:Name="AssignButton" Content="Assign selection" Style="{StaticResource ToolButton}"
                            Click="OnAssign" />
                    <Button x:Name="RemoveButton" Content="Remove selection" Style="{StaticResource ToolButton}"
                            Click="OnRemove" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="EnableButton" Content="Enable all" Style="{StaticResource ToolButton}"
                            Click="OnEnable" />
                    <Button x:Name="DisableButton" Content="Disable all" Style="{StaticResource ToolButton}"
                            Click="OnDisable" />
                    <Button x:Name="RenameButton" Content="Rename…" Style="{StaticResource ToolButton}"
                            Click="OnRename" />
                    <Button x:Name="DeleteButton" Content="Delete group" Style="{StaticResource ToolButton}"
                            Click="OnDelete" />
                </StackPanel>
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Padding="18,7"
                        HorizontalAlignment="Right" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
