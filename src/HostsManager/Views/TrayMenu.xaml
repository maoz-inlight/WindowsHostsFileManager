<Window x:Class="HostsManager.Views.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HostsManager.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" FontFamily="{StaticResource UiFont}" WindowStartupLocation="Manual">

    <Window.Resources>
        <DataTemplate DataType="{x:Type views:TrayHeaderRow}">
            <Button Style="{StaticResource TrayRowButton}" Click="OnHeaderClick">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TrayActionRow}">
            <Button Style="{StaticResource TrayRowButton}" Click="OnActionClick">
                <TextBlock Text="{Binding Label}" FontSize="12.5" />
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TrayToggleRow}">
            <Button Style="{StaticResource TrayRowButton}" Click="OnToggleClick" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}"
                              IsHitTestVisible="False" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TrayTextRow}">
            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                       Padding="10,7" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TraySeparator}">
            <Border Height="1" Background="{DynamicResource Border0}" Margin="8,5" />
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="230">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.32" Color="Black" Direction="270" />
        </Border.Effect>
        <ItemsControl x:Name="Rows" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</Window>
