<Window x:Class="HostsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts manager" Height="640" Width="980" MinWidth="780" MinHeight="420"
        Icon="Assets/app.ico"
        Background="{DynamicResource Surface0}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Surface1}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Border0}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenIsolatedBrowserCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hosts manager" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource WarningBg}" Margin="10,0,0,0">
                        <TextBlock x:Name="PrivilegeText" Text="Administrator" FontSize="11" Foreground="{DynamicResource Warning}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Margin="10,0,0,0" Click="OnAbout"
                            ToolTip="About Hosts manager" AutomationProperties.Name="About Hosts manager">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border0}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add" Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" Padding="9,6" />
                    <Button Content="Edit" Style="{StaticResource ToolButton}" Command="{Binding EditCommand}"
                            Padding="9,6" ToolTip="Edit selected entry (F2)" />
                    <Button Content="Groups" Style="{StaticResource ToolButton}" Command="{Binding GroupsCommand}" Padding="9,6"
                            ToolTip="Assign selected entries or enable and disable groups together" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Background="{DynamicResource Border0}" Margin="4,2,8,2" />
                    <Button Style="{StaticResource PreviewButton}" Command="{Binding OpenIsolatedBrowserCommand}"
                            Padding="8,6"
                            AutomationProperties.Name="Preview in browser"
                            AutomationProperties.HelpText="{Binding PreviewToolbarStatus}"
                            AutomationProperties.AcceleratorKey="Ctrl+Shift+O"
                            ToolTip="Open the selected entries in an isolated browser (Ctrl+Shift+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Data="M 1,1 H 12 V 10 H 1 Z M 1,4 H 12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Preview in browser" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center"
                      HorizontalAlignment="Left" MaxWidth="320">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding PreviewToolbarStatus, NotifyOnTargetUpdated=True}"
                                   TargetUpdated="OnPreviewStatusUpdated" AutomationProperties.LiveSetting="Polite"
                                   FontSize="12" LineHeight="14"
                                   LineStackingStrategy="BlockLineHeight" MaxHeight="28" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PreviewToolbarStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowserPreviewActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DockPanel Visibility="{Binding IsBrowserPreviewActive, Converter={StaticResource BoolToVis}}">
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,5,0"
                                     Fill="{Binding BrowserPreviewColor}" Stroke="{DynamicResource TextSecondary}"
                                     ToolTip="{Binding BrowserPreviewColorLabel}"
                                     AutomationProperties.Name="{Binding BrowserPreviewColorLabel}" />
                            <TextBlock Text="{Binding BrowserPreviewText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BrowserPreviewText}" />
                        </DockPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Close preview" Style="{StaticResource LinkButton}"
                            FocusVisualStyle="{StaticResource KeyboardFocus}"
                            Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="2,0,4,0"
                            Command="{Binding EndBrowserPreviewCommand}"
                            Visibility="{Binding IsBrowserPreviewActive, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Background="{DynamicResource Border0}" Margin="0,2,8,2" />
                    <Button Content="Revert" Style="{StaticResource ToolButton}" Command="{Binding RevertCommand}" Padding="8,6" />
                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                            Padding="11,6" />
                    <Border Width="1" Background="{DynamicResource Border0}" Margin="8,2" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Click="OnMore"
                            ToolTip="More actions" AutomationProperties.Name="More actions">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource OverflowMenu}">
                                <MenuItem Header="Delete selected entry" Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding DeleteCommand}" InputGestureText="Del" />
                                <Separator Style="{StaticResource OverflowSeparator}" />
                                <MenuItem Header="Backups…" Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding BackupsCommand}" />
                                <MenuItem Header="Browser preview data…" Style="{StaticResource OverflowMenuItem}"
                                          Click="OnBrowserProfiles" />
                                <Separator Style="{StaticResource OverflowSeparator}" />
                                <MenuItem Header="Import entries…" Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding ImportCommand}"
                                          ToolTip="Replace editable entries from another hosts file" />
                                <MenuItem Header="Merge entries…" Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding MergeCommand}"
                                          ToolTip="Add hostnames from another hosts file, skipping duplicates" />
                                <Separator Style="{StaticResource OverflowSeparator}" />
                                <MenuItem Header="Flush DNS cache" Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding FlushDnsCommand}" />
                                <MenuItem Header="{Binding OpenIsolatedBrowserText}"
                                          Style="{StaticResource OverflowMenuItem}"
                                          Command="{Binding OpenIsolatedBrowserCommand}"
                                          ToolTip="Open the selected domains in a browser without changing Windows DNS" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Another tool rewrote the file while we had it open -->
        <Border Grid.Row="2" Background="{DynamicResource AccentBg}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="{Binding HasExternalChange, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="This file was changed by another program. Reload to see the current contents."
                           FontSize="12.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <Button Content="Reload" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Foreground="{DynamicResource Accent}" Command="{Binding ReloadCommand}" />
            </Grid>
        </Border>

        <!-- Corruption and duplicate warnings -->
        <Border Grid.Row="3" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding ProblemText}" FontSize="12.5" Foreground="{DynamicResource Warning}"
                           VerticalAlignment="Center" />
                <Button Content="Review" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Foreground="{DynamicResource Warning}" Command="{Binding ShowProblemsCommand}" />
            </Grid>
        </Border>

        <!-- Filter -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Border0}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="Search entries" Style="{StaticResource FlatTextBox}" Padding="31,0,9,0"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             ToolTip="Filter by domain, IP address, comment, source, group, or status" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Search domains, IPs, comments, sources, groups, or status"
                               Foreground="{DynamicResource TextMuted}" Margin="31,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1" Width="160" Margin="8,0,0,0"
                          AutomationProperties.Name="Filter by group"
                          Style="{StaticResource FlatComboBox}"
                          ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                          ItemsSource="{Binding GroupOptions}"
                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />

                <ComboBox Grid.Column="2" x:Name="FilterBox" Width="150" Margin="8,0,0,0"
                          AutomationProperties.Name="Filter by status"
                          Style="{StaticResource FlatComboBox}"
                          ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                          SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All entries" />
                    <ComboBoxItem Content="Loopback only" />
                    <ComboBoxItem Content="Problems only" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Entries -->
        <DataGrid Grid.Row="5" x:Name="EntryGrid" ItemsSource="{Binding EntriesView}"
                  AutomationProperties.Name="Hosts entries"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionChanged="OnEntrySelectionChanged"
                  PreviewMouseRightButtonDown="OnEntryGridPreviewMouseRightButtonDown"
                  ContextMenuOpening="OnEntryGridContextMenuOpening"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border0}"
                  Background="{DynamicResource Surface2}" BorderThickness="0" RowHeight="34"
                  ColumnHeaderStyle="{StaticResource GridColumnHeader}" CellStyle="{StaticResource GridCell}"
                  SelectionMode="Extended" IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.InputBindings>
                <KeyBinding Key="F2" Command="{Binding EditCommand}" />
                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource OverflowMenu}">
                    <MenuItem Header="Edit entry…" Command="{Binding EditCommand}" Style="{StaticResource OverflowMenuItem}" />
                    <MenuItem Header="{Binding OpenIsolatedBrowserText}"
                              Style="{StaticResource OverflowMenuItem}"
                              Command="{Binding OpenIsolatedBrowserCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.RowStyle>
                <!-- Selection styling lives in GridRow, shared with the backups grid. -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Invalid">
                            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Pending">
                            <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Toggle, or a lock for blocks another tool owns -->
                <DataGridTemplateColumn Width="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="14,0,0,0" HorizontalAlignment="Left">
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.Name="{Binding Domain, StringFormat=Enable {0}}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Left"
                                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                <!--
                                    An unparseable line has no toggle and nothing else clickable
                                    on the row, so without this the only way to act on it is to
                                    know the toolbar Delete button exists. This makes removing it
                                    the one click the row's own warning icon promises.
                                -->
                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0"
                                        ToolTip="Delete this line" AutomationProperties.Name="Delete invalid line"
                                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsUnparseable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource Danger}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Domain" Width="*" MinWidth="150" SortMemberPath="Domain">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Disabled">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Managed">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Maps to" Width="140" SortMemberPath="MapsToSortKey">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MapsTo}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Source" Width="100" SortMemberPath="Source">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Source}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Group" Width="125" SortMemberPath="Group">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Group}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="104" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Normal">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Disabled">
                                                <Setter Property="Background" Value="{DynamicResource Surface1}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar. Showing the encoding is the visible proof the format is preserved. -->
        <Border Grid.Row="6" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding HostsPath}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HostsPath}" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource Success}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                        <Run Text="{Binding FormatText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CountsText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding BackupText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
