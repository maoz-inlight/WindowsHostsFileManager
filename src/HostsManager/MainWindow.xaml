<Window x:Class="HostsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts manager" Height="640" Width="900" MinWidth="720" MinHeight="420"
        Icon="Assets/app.ico"
        Background="{DynamicResource Surface0}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hosts manager" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource WarningBg}" Margin="10,0,0,0">
                        <TextBlock Text="Administrator" FontSize="11" Foreground="{DynamicResource Warning}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border0}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add" Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" />
                    <Button Content="Delete" Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" />
                    <Border Width="1" Background="{DynamicResource Border0}" Margin="6,2" />
                    <Button Content="Reload" Style="{StaticResource ToolButton}" Command="{Binding ReloadCommand}" />
                    <Button Content="Backups" Style="{StaticResource ToolButton}" Command="{Binding BackupsCommand}" />
                    <Button Content="Flush DNS" Style="{StaticResource ToolButton}" Command="{Binding FlushDnsCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Revert" Style="{StaticResource ToolButton}" Command="{Binding RevertCommand}" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                            Padding="16,6" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Another tool rewrote the file while we had it open -->
        <Border Grid.Row="2" Background="{DynamicResource AccentBg}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="{Binding HasExternalChange, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="This file was changed by another program. Reload to see the current contents."
                           FontSize="12.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <Button Content="Reload" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Foreground="{DynamicResource Accent}" Command="{Binding ReloadCommand}" />
            </Grid>
        </Border>

        <!-- Corruption and duplicate warnings -->
        <Border Grid.Row="3" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding ProblemText}" FontSize="12.5" Foreground="{DynamicResource Warning}"
                           VerticalAlignment="Center" />
                <Button Content="Review" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Foreground="{DynamicResource Warning}" Command="{Binding ShowProblemsCommand}" />
            </Grid>
        </Border>

        <!-- Filter -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Border0}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" />

                <ComboBox Grid.Column="1" x:Name="FilterBox" Width="150" Margin="8,0,0,0"
                          Style="{StaticResource FlatComboBox}"
                          ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                          SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All entries" />
                    <ComboBoxItem Content="Loopback only" />
                    <ComboBoxItem Content="Problems only" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Entries -->
        <DataGrid Grid.Row="5" x:Name="EntryGrid" ItemsSource="{Binding EntriesView}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border0}"
                  Background="{DynamicResource Surface2}" BorderThickness="0" RowHeight="34"
                  ColumnHeaderStyle="{StaticResource GridColumnHeader}" CellStyle="{StaticResource GridCell}"
                  SelectionMode="Single" IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource Surface2}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Invalid">
                            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Pending">
                            <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Surface1}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Toggle, or a lock for blocks another tool owns -->
                <DataGridTemplateColumn Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="14,0,0,0" HorizontalAlignment="Left">
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Left"
                                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource Danger}" VerticalAlignment="Center"
                                           Visibility="{Binding IsUnparseable, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Domain" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Disabled">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Managed">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Maps to" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MapsTo}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Source" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Source}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Normal">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Disabled">
                                                <Setter Property="Background" Value="{DynamicResource Surface1}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar. Showing the encoding is the visible proof the format is preserved. -->
        <Border Grid.Row="6" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border0}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding HostsPath}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HostsPath}" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource Success}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                        <Run Text="{Binding FormatText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CountsText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding BackupText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
