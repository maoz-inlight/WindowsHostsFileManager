<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    One MSI per CPU architecture, built from the matching self-contained publish output.
    The UpgradeCode is shared across architectures on purpose: it is one product, and a
    machine only ever installs the build that matches its CPU, so installing over an
    earlier version replaces it rather than stacking up entries in Programs and Features.
  -->
  <Package Name="Hosts manager"
           Manufacturer="Maoz Maroody"
           Version="$(Version)"
           UpgradeCode="7B1F4C2E-9A63-4D18-B5E7-2C8A1F6D3E90"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Manage the Windows hosts file: add, remove and toggle domain overrides." />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Hosts manager is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(SourceDir)\..\..\src\HostsManager\Assets\app.ico" />
    <!-- ARPNOMODIFY is already set by WixUI_InstallDir. -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!--
      Windows 11 or later, by choice rather than by technical floor: the bundled .NET 8
      runtime would also run on Windows 10 1607+, but this is only developed and tested
      against Windows 11.

      Do NOT use VersionNT or WindowsBuild here. msiexec.exe is not manifested for Windows
      10/11, so GetVersionEx shims it: on a real Windows 11 build-26200 machine it reports
      VersionNT=603 and WindowsBuild=9600 - Windows 8.1's numbers. Reading those same
      properties through the WindowsInstaller COM API from a manifested process returns the
      true 1000/26200, which is how an earlier version of this condition passed testing and
      then rejected every actual machine it ran on.

      The registry is not shimmed, so the build number comes from there. It is compared as
      a string because MSI evaluates any string-to-integer comparison as false; that is
      safe here because every Windows 10 (10240-19045) and Windows 11 (22000+) build number
      is five digits, so lexicographic order matches numeric order. Revisit if build
      numbers ever reach six digits.

      If the search finds nothing the property is empty, "" >= "22000" is false, and the
      install is refused - failing closed rather than open.
    -->
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="CurrentBuildNumber"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR (WINDOWSBUILDNUMBER &gt;= &quot;22000&quot;)"
            Message="Hosts manager requires Windows 11 or later." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Hosts manager" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="HostsManagerExe"
              Source="$(SourceDir)\HostsManager.exe"
              KeyPath="yes">
          <!--
            Deliberately NOT Advertise="yes". Advertised shortcuts resolve their target
            through the Windows Installer at launch time instead of pointing at the exe
            directly, and Windows Search's app index doesn't always pick them up as a
            launchable app — they can end up findable only via the Programs and Features
            entry. A plain shortcut with a real target avoids that.
          -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Hosts manager"
                    Description="Add, remove and toggle hosts file entries"
                    Icon="AppIcon"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>

      <Component Id="ReadmeFile" Guid="*">
        <File Id="ReadmeMd" Source="$(SourceDir)\..\..\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Hosts manager" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!--
      Backups live in %LOCALAPPDATA%\HostsManager and are deliberately NOT registered
      with the installer, so uninstalling never removes a user's way back to a working
      hosts file.
    -->

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(SourceDir)\..\..\installer\License.rtf" />

    <!--
      Without this the wizard's Finish page just says "Click Finish to exit" with no
      indication anything happened. This adds a checked-by-default "Launch Hosts manager"
      box, so finishing the wizard also proves the install worked.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Hosts manager" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#HostsManagerExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Return="check" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
